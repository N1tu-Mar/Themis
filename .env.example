# Runtime mode. Local mode makes no paid/external calls.
THEMIS_MODE=local

# AWS/CDK deployment target. Credentials use the standard AWS credential chain.
AWS_REGION=us-east-1
CDK_DEFAULT_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=

# Product capabilities.
ENABLE_RCS=false
ENABLE_SMS_FALLBACK=true
ENABLE_SES=true
ENABLE_BROWSER_RESEARCH=false
ENABLE_PROACTIVE_DETECTION=false
ENABLE_REASONING_ESCALATION=true

# Required before deploying with THEMIS_MODE=aws.
BEDROCK_MODEL_ID_FAST=
BEDROCK_MODEL_ID_REASONING=

# Deterministic policy thresholds shared by Cedar and bank-tools.
DEMO_AUTONOMOUS_CREDIT_LIMIT=50
DEMO_CREDIT_CONFIDENCE_THRESHOLD=0.8

# Messaging identities. Provision/verify these manually before live messaging.
THEMIS_RCS_POOL_ID=
THEMIS_SMS_IDENTITY=
THEMIS_SES_FROM=
THEMIS_SUPPORT=
SES_SENDER_DOMAIN=themis-demo.example

# CDK injects these into Lambda, AgentCore, and Amplify at deployment.
# Do not normally set them by hand.
# TRANSACTIONS_TABLE=
# CASES_TABLE=
# MERCHANTS_TABLE=
# AUDIT_TABLE=
# IDEMPOTENCY_TABLE=
# ARTIFACTS_BUCKET=
# AGENT_RUNTIME_ARN=
# GATEWAY_IDENTIFIER=
# GATEWAY_URL=
# MEMORY_ID=
