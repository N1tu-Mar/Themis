{
  "name": "themis",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*",
    "infra"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:python": "python3 -m pytest -q",
    "check": "npm run build && npm test && npm run test:python"
  }
}
